{
  "version": 1,
  "outputs": [
    {
      "path": "summary.json",
      "required": true,
      "min_bytes": 20,
      "max_bytes": 65536,
      "format": "json",
      "required_keys": ["schema", "seed", "steps", "samples", "final_loss", "rmse", "coefficients", "dataset_sha256"]
    },
    {
      "path": "curve.csv",
      "required": true,
      "min_bytes": 20,
      "max_bytes": 2097152,
      "format": "csv",
      "columns": ["step", "loss", "rmse", "slope", "intercept"],
      "min_rows": 1
    },
    {
      "path": "dataset.csv",
      "required": true,
      "min_bytes": 10,
      "max_bytes": 4194304,
      "format": "csv",
      "columns": ["x", "y"],
      "min_rows": 4
    },
    {
      "path": "metrics.jsonl",
      "required": true,
      "min_bytes": 1,
      "max_bytes": 4194304,
      "format": "text"
    }
  ]
}
